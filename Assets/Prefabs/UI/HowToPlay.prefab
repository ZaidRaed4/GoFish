  m_Script: {fileID: 11500000, guid: 7e7d033d00ba99b488dc1f6125e403ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  root: {fileID: 2403393350519974377}
  headingText: {fileID: 2173675320583739280}
  bodyText: {fileID: 3506890874937780401}
  pageText: {fileID: 725353105781732149}
  nextLabel: {fileID: 8316978449775910850}
  backButton: {fileID: 2825758371249641285}
  nextButton: {fileID: 2464752185019814252}
  closeButton: {fileID: 6257567281057044695}
  pages:
  - heading: Ask
    body: 'On your turn, tap a bot, then pick a rank you hold.


      If they have
      none of that rank: go fish! You draw a card and your turn ends.'
  - heading: Count
    body: 'If they have it, guess how many cards of that rank they hold.


      Wrong
      guess: you draw a card and your turn ends.'
  - heading: Suits
    body: 'Right count? Now pick which suits they hold <sprite name="SUIT_C" tint=1>
      <sprite name="SUIT_D" tint=1> <sprite name="SUIT_H" tint=1> <sprite name="SUIT_S"
      tint=1>. Suits you hold in that rank can''t be theirs, so they are left out.
      If only one choice is left, it is made for you.


      Right suits: take the
      cards and play again. Wrong: you draw a card and your turn ends.'
  - heading: Books
    body: 'Four cards of one rank make a book. Books are laid for you.


      The
      game ends when all 13 books are laid or nobody can catch the leader. Most books
      wins.


      Tip: drag cards to arrange your hand, tap a card to raise it.'
